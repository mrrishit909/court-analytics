 "components": {
  "schemas": {
   "BriefIn": {
    "properties": {
     "motion_type": {
      "type": "string",
      "enum": [
       "dismiss",
       "summary_judgment",
       "compel",
       "preliminary_injunction"
      ],
      "title": "Motion Type"
     },
     "judge_id": {
      "type": "string",
      "format": "uuid",
      "title": "Judge Id"
     },
     "nature_of_suit": {
      "type": "string",
      "enum": [
       "employment",
       "contract",
       "civil_rights",
       "patent",
       "injury",
       "securities"
      ],
      "title": "Nature Of Suit"
     },
     "facts": {
      "type": "string",
      "maxLength": 5000,
      "minLength": 40,
      "title": "Facts",
      "description": "The fact section. Confidential: stored only in this tenant's workspace, never logged"
     },
     "pro_se": {
      "type": "boolean",
      "title": "Pro Se",
      "default": false
     },
     "amended": {
      "type": "integer",
      "maximum": 10.0,
      "minimum": 0.0,
      "title": "Amended",
      "default": 0
     },
     "claims": {
      "type": "integer",
      "maximum": 50.0,
      "minimum": 1.0,
      "title": "Claims",
      "default": 1
     },
     "large_firm_defence": {
      "type": "boolean",
      "title": "Large Firm Defence",
      "default": false
     },
     "cited_dockets": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 20,
      "title": "Cited Dockets"
     }
    },
    "type": "object",
    "required": [
     "motion_type",
     "judge_id",
     "nature_of_suit",
     "facts"
    ],
    "title": "BriefIn"
   },
   "EstimateIn": {
    "properties": {
     "motion_type": {
      "type": "string",
      "enum": [
       "dismiss",
       "summary_judgment",
       "compel",
       "preliminary_injunction"
      ],
      "title": "Motion Type"
     },
     "judge_id": {
      "type": "string",
      "format": "uuid",
      "title": "Judge Id"
     },
     "nature_of_suit": {
      "type": "string",
      "enum": [
       "employment",
       "contract",
       "civil_rights",
       "patent",
       "injury",
       "securities"
      ],
      "title": "Nature Of Suit"
     },
     "facts": {
      "type": "string",
      "maxLength": 5000,
      "minLength": 40,
      "title": "Facts",
      "description": "The fact section. Confidential: stored only in this tenant's workspace, never logged"
     },
     "pro_se": {
      "type": "boolean",
      "title": "Pro Se",
      "default": false
     },
     "amended": {
      "type": "integer",
      "maximum": 10.0,
      "minimum": 0.0,
      "title": "Amended",
      "default": 0
     },
     "claims": {
      "type": "integer",
      "maximum": 50.0,
      "minimum": 1.0,
      "title": "Claims",
      "default": 1
     },
     "large_firm_defence": {
      "type": "boolean",
      "title": "Large Firm Defence",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "motion_type",
     "judge_id",
     "nature_of_suit",
     "facts"
    ],
    "title": "EstimateIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "IngestIn": {
    "properties": {
     "source": {
      "type": "string",
      "pattern": "^demo-dockets$",
      "title": "Source",
      "description": "The one source in this build: a deterministic synthetic court system",
      "default": "demo-dockets"
     }
    },
    "type": "object",
    "title": "IngestIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}